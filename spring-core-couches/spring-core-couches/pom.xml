<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- EXO 1 : Spring Boot = Spring + autoconfiguration + starters. Le parent fixe les versions compatibles
         de toutes les dépendances (on n'écrit donc pas de <version> pour les starters). -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.youcode</groupId>
    <artifactId>spring-core-couches</artifactId>
    <version>1.0.0</version>
    <name>spring-core-couches</name>
    <description>IoC, DI, beans et architecture en couches</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- starter-web : Spring MVC + Tomcat embarqué + Jackson (JSON).
             Sert à exposer l'API REST (@RestController, DispatcherServlet). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- starter-validation : Jakarta Bean Validation (Hibernate Validator).
             Permet @NotBlank, @Positive... et @Valid sur les DTO -> erreurs 400. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- starter-data-jpa : Spring Data JPA + Hibernate pour la persistance.
             Présent car il fait partie du socle du sprint ; ici le repository est en mémoire. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- h2 : base en mémoire, nécessaire pour que data-jpa démarre sans configurer PostgreSQL. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- springdoc-openapi : génère la doc OpenAPI et l'interface Swagger UI
             (http://localhost:8080/swagger-ui.html) pour tester l'API (exo 10). -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.6.0</version>
        </dependency>

        <!-- devtools : redémarrage automatique à chaque recompilation (confort de dev, jamais en prod). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- starter-test : JUnit 5, Mockito, AssertJ, MockMvc, @SpringBootTest. Uniquement pour les tests. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Plugin Spring Boot : mvn spring-boot:run et création du jar exécutable. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
